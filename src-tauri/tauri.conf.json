{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brett-Net",
  "version": "0.1.0",
  "identifier": "net.brett.brettnet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brett-Net",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Brett Pittman",
    "category": "Utility",
    "shortDescription": "Network monitoring toolkit",
    "longDescription": "Monitor latency across many hosts at once, trace network paths, and inspect local network configuration.",
    "publisher": "Brett Pittman",
    "homepage": "https://github.com/agbrettpittman/Brett-Net",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QzUxMzFEQ0VERDMxOUMKUldTY01kM09IUlBGV0QyY0xtZGszQW1qMG5qRUFSQnZjU3lLOEZYcnVja1RZMDBkNXhLQ2NrKzgK",
      "endpoints": [
        "https://github.com/agbrettpittman/Brett-Net/releases/latest/download/latest.json"
      ]
    }
  }
}
